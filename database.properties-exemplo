# =========================================================
# CONFIGURAÇÕES DO BANCO DE DADOS
# Sistema Locadora - Programação III
# =========================================================
#
# Este arquivo serve como exemplo de configuração.
# Para usar o sistema, copie este arquivo, renomeie para
# database.properties e coloque em:
#
# src/main/resources/database.properties
#
# IMPORTANTE:
# - Não coloque aspas nos valores.
# - Altere usuário e senha conforme o seu PostgreSQL.
# - O banco informado em db.name precisa existir antes de executar o sistema.
# =========================================================

# Tipo de banco usado pelo sistema.
# Para este projeto, mantenha postgresql.
db.driver=postgresql

# Endereço do servidor do banco.
# Em ambiente local, normalmente será localhost.
db.host=localhost

# Porta do PostgreSQL.
# A porta padrão é 5432.
db.port=5432

# Nome do banco de dados usado pelo sistema.
# Esse banco deve ser criado antes de executar a aplicação.
db.name=locadora_db

# Usuário do PostgreSQL.
# Altere conforme o usuário configurado na sua máquina.
db.user=seu_usuario

# Senha do usuário do PostgreSQL.
# Altere conforme a senha configurada na sua máquina.
db.password=sua_senha