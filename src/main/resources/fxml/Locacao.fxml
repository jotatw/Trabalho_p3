<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER"
      spacing="0"
      prefWidth="1100"
      prefHeight="720"
      styleClass="pagina"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.br.ifg.luziania.trabalho_p3.controller.LocacaoController">
    <VBox styleClass="tela-formulario">
        <VBox styleClass="painel-formulario">
            <GridPane hgap="12" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="120" prefWidth="140" />
                    <ColumnConstraints minWidth="220" prefWidth="280" />
                    <ColumnConstraints minWidth="110" prefWidth="130" />
                    <ColumnConstraints hgrow="ALWAYS" minWidth="160" prefWidth="200" />
                </columnConstraints>

                <Label styleClass="rotulo-campo" text="CPF" />
                <TextField fx:id="campoCpf" styleClass="campo-texto" GridPane.columnIndex="1" />
                <Button fx:id="btnBuscarCliente" mnemonicParsing="false" onAction="#buscarCliente" styleClass="btn-secundario" text="Buscar" GridPane.columnIndex="2" />
                <Label fx:id="labelCliente" styleClass="rotulo-resultado" text="-" GridPane.columnIndex="3" />

                <Label styleClass="rotulo-campo" text="Veículo" GridPane.rowIndex="1" />

                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <ComboBox fx:id="comboVeiculosDisponiveis"
                              promptText="Selecione um veículo disponível"
                              styleClass="campo-texto"
                              maxWidth="Infinity" />

                    <TextField fx:id="campoPlaca"
                               promptText="Ou digite a placa manualmente"
                               styleClass="campo-texto" />
                </VBox>

                <Button fx:id="btnBuscarVeiculo"
                        mnemonicParsing="false"
                        onAction="#buscarVeiculo"
                        styleClass="btn-secundario"
                        text="Buscar"
                        GridPane.columnIndex="2"
                        GridPane.rowIndex="1" />

                <Label fx:id="labelVeiculo"
                       styleClass="rotulo-resultado"
                       text="-"
                       GridPane.columnIndex="3"
                       GridPane.rowIndex="1" />

                <Label styleClass="rotulo-campo" text="Retirada" GridPane.rowIndex="2" />
                <DatePicker fx:id="dataRetirada" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label styleClass="rotulo-campo" text="Devolucao" GridPane.rowIndex="3" />
                <DatePicker fx:id="dataDevolucao" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label styleClass="rotulo-campo" text="Valor total" GridPane.rowIndex="4" />
                <Label fx:id="labelValor" styleClass="rotulo-resultado" text="R$ 0,00" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>

            <HBox styleClass="linha-btn">
                <Button fx:id="btnConfirmar" mnemonicParsing="false" onAction="#confirmarLocacao" styleClass="btn-primario" text="Confirmar Locacao" />
                <Button fx:id="btnVoltar" mnemonicParsing="false" onAction="#voltar" styleClass="btn-secundario" text="Voltar" />
            </HBox>
        </VBox>
    </VBox>
</VBox>
