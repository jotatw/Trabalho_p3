<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox alignment="TOP_CENTER" spacing="20" styleClass="home-conteudo" stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.br.ifg.luziania.trabalho_p3.controller.DevolucaoController">

    <VBox styleClass="tela-formulario">
        <HBox alignment="CENTER_LEFT" styleClass="cabecalho-tela">
            <VBox HBox.hgrow="ALWAYS">
                <Label styleClass="titulo-tela" text="Registro de Devolução" />
                <Label styleClass="subtitulo-tela" text="Finalize locações e calcule eventuais multas por atraso." />
            </VBox>
            <Button fx:id="btnVoltar" onAction="#voltarAction" styleClass="btn-secundario" text="Voltar">
                <graphic><FontIcon iconLiteral="fas-arrow-left"/></graphic>
            </Button>
        </HBox>

        <VBox spacing="30" styleClass="painel-formulario">
            <VBox spacing="15" style="-fx-background-color: #F8FAFC; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12;">
                <Label text="Localizar Locação Ativa" style="-fx-font-weight: bold; -fx-font-size: 15;"/>
                <HBox spacing="20">
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="Selecione a Placa" styleClass="rotulo-campo" />
                        <ComboBox fx:id="comboPlacasAtivas" maxWidth="Infinity" promptText="Veículos em uso..." styleClass="combo-box" />
                    </VBox>
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="Ou digite manualmente" styleClass="rotulo-campo" />
                        <HBox spacing="10">
                            <TextField fx:id="campoPlaca" promptText="ABC1D23" styleClass="campo-texto" HBox.hgrow="ALWAYS" />
                            <Button onAction="#buscarVeiculo" styleClass="btn-primario">
                                <graphic><FontIcon iconLiteral="fas-search" iconColor="white"/></graphic>
                            </Button>
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>

            <GridPane hgap="30" vgap="25">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" />
                    <ColumnConstraints percentWidth="50" />
                </columnConstraints>

                <!-- Resumo da Locação -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12;">
                    <Label text="Resumo do Contrato" style="-fx-font-weight: bold; -fx-text-fill: #64748B;"/>
                    <VBox spacing="10">
                        <HBox spacing="10">
                            <Label text="Cliente:" styleClass="rotulo-campo" minWidth="80" />
                            <Label fx:id="labelCliente" text="-" style="-fx-font-weight: bold;" />
                        </HBox>
                        <HBox spacing="10">
                            <Label text="Retirada:" styleClass="rotulo-campo" minWidth="80" />
                            <Label fx:id="labelRetirada" text="-" />
                        </HBox>
                        <HBox spacing="10">
                            <Label text="Prevista:" styleClass="rotulo-campo" minWidth="80" />
                            <Label fx:id="labelDevolucao" text="-" />
                        </HBox>
                        <Separator />
                        <HBox spacing="10">
                            <Label text="Valor Base:" styleClass="rotulo-campo" minWidth="80" />
                            <Label fx:id="labelValor" text="R$ 0,00" style="-fx-font-weight: bold; -fx-text-fill: #1E40AF;" />
                        </HBox>
                    </VBox>
                </VBox>

                <!-- Fechamento e Multas -->
                <VBox spacing="15" style="-fx-background-color: #FFF7ED; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #FFEDD5; -fx-border-radius: 12;" GridPane.columnIndex="1">
                    <Label text="Cálculo de Devolução" style="-fx-font-weight: bold; -fx-text-fill: #9A3412;"/>
                    <VBox spacing="10">
                        <HBox spacing="10">
                            <Label text="Atraso:" styleClass="rotulo-campo" minWidth="100" />
                            <Label fx:id="labelAtraso" text="-" style="-fx-font-weight: bold;" />
                        </HBox>
                        <HBox spacing="10">
                            <Label text="Multa (20%):" styleClass="rotulo-campo" minWidth="100" />
                            <Label fx:id="labelMulta" text="R$ 0,00" style="-fx-text-fill: #DC2626; -fx-font-weight: bold;" />
                        </HBox>
                        <Separator />
                        <VBox alignment="CENTER_RIGHT" spacing="5">
                            <Label text="TOTAL A PAGAR" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #9A3412;" />
                            <Label fx:id="labelValorFinal" text="R$ 0,00" style="-fx-font-size: 24; -fx-font-weight: 900; -fx-text-fill: #9A3412;" />
                        </VBox>
                    </VBox>
                </VBox>
            </GridPane>

            <HBox alignment="CENTER_RIGHT">
                <Button onAction="#confirmarDevolucao" styleClass="btn-primario" prefHeight="50" prefWidth="250" style="-fx-font-size: 16; -fx-background-color: #10B981;">
                    <graphic><FontIcon iconLiteral="fas-check-double" iconColor="white"/></graphic>
                    <text>Finalizar Devolução</text>
                </Button>
            </HBox>
        </VBox>
    </VBox>
</VBox>
