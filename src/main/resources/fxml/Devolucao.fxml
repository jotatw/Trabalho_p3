<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER"
      spacing="20"
      styleClass="home-conteudo"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.br.ifg.luziania.trabalho_p3.controller.DevolucaoController">

    <VBox styleClass="tela-formulario">

        <!-- Cabeçalho da tela -->
        <HBox alignment="CENTER_LEFT" styleClass="cabecalho-tela">
            <VBox HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="↩" styleClass="icone-titulo" />
                    <Label styleClass="titulo-tela" text="Registro de Devolução" />
                </HBox>

                <Label styleClass="subtitulo-tela"
                       text="Finalize locações e calcule eventuais multas por atraso." />
            </VBox>

            <Button fx:id="btnVoltar"
                    onAction="#voltarAction"
                    styleClass="btn-secundario"
                    text="← Voltar" />
        </HBox>

        <!-- Formulário de devolução -->
        <VBox spacing="25" styleClass="painel-formulario">

            <!-- Localização da locação ativa -->
            <VBox spacing="15" styleClass="bloco-operacao">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="🔍" styleClass="icone-bloco" />
                    <Label text="Localizar Locação Ativa" styleClass="titulo-bloco" />
                </HBox>

                <HBox spacing="20">
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="Selecione a placa" styleClass="rotulo-campo" />
                        <ComboBox fx:id="comboPlacasAtivas"
                                  maxWidth="Infinity"
                                  promptText="Veículos em uso..."
                                  styleClass="campo-texto" />
                    </VBox>

                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="Ou digite manualmente" styleClass="rotulo-campo" />
                        <HBox spacing="10">
                            <TextField fx:id="campoPlaca"
                                       promptText="ABC1D23"
                                       styleClass="campo-texto"
                                       HBox.hgrow="ALWAYS" />

                            <Button onAction="#buscarVeiculo"
                                    styleClass="btn-primario"
                                    text="🔍 Buscar" />
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Resumo e cálculo -->
            <GridPane hgap="25" vgap="25">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" />
                    <ColumnConstraints percentWidth="50" />
                </columnConstraints>

                <!-- Resumo da locação -->
                <VBox spacing="15" styleClass="bloco-operacao">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📄" styleClass="icone-bloco" />
                        <Label text="Resumo do Contrato" styleClass="titulo-bloco" />
                    </HBox>

                    <VBox spacing="10">
                        <HBox spacing="10">
                            <Label text="Cliente:" styleClass="rotulo-campo" minWidth="90" />
                            <Label fx:id="labelCliente" text="-" styleClass="texto-destaque" />
                        </HBox>

                        <HBox spacing="10">
                            <Label text="Retirada:" styleClass="rotulo-campo" minWidth="90" />
                            <Label fx:id="labelRetirada" text="-" />
                        </HBox>

                        <HBox spacing="10">
                            <Label text="Prevista:" styleClass="rotulo-campo" minWidth="90" />
                            <Label fx:id="labelDevolucao" text="-" />
                        </HBox>

                        <Separator />

                        <HBox spacing="10">
                            <Label text="Valor Base:" styleClass="rotulo-campo" minWidth="90" />
                            <Label fx:id="labelValor" text="R$ 0,00" styleClass="texto-destaque" />
                        </HBox>
                    </VBox>
                </VBox>

                <!-- Cálculo da devolução -->
                <VBox spacing="15" styleClass="bloco-operacao, bloco-alerta" GridPane.columnIndex="1">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="💰" styleClass="icone-bloco" />
                        <Label text="Cálculo de Devolução" styleClass="titulo-bloco-alerta" />
                    </HBox>

                    <VBox spacing="10">
                        <HBox spacing="10">
                            <Label text="Atraso:" styleClass="rotulo-campo" minWidth="110" />
                            <Label fx:id="labelAtraso" text="-" styleClass="texto-destaque" />
                        </HBox>

                        <HBox spacing="10">
                            <Label text="Multa (20%):" styleClass="rotulo-campo" minWidth="110" />
                            <Label fx:id="labelMulta" text="R$ 0,00" styleClass="texto-perigo" />
                        </HBox>

                        <Separator />

                        <VBox alignment="CENTER_RIGHT" spacing="5">
                            <Label text="TOTAL A PAGAR" styleClass="rotulo-total-alerta" />
                            <Label fx:id="labelValorFinal"
                                   text="R$ 0,00"
                                   styleClass="valor-total-alerta" />
                        </VBox>
                    </VBox>
                </VBox>
            </GridPane>

            <!-- Ação principal -->
            <HBox alignment="CENTER_RIGHT">
                <Button onAction="#confirmarDevolucao"
                        styleClass="btn-primario, btn-grande, btn-confirmar-verde"
                        text="✅ Finalizar Devolução" />
            </HBox>
        </VBox>
    </VBox>
</VBox>