<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER"
      spacing="0"
      prefWidth="1100"
      prefHeight="720"
      styleClass="pagina"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.br.ifg.luziania.trabalho_p3.controller.DevolucaoController">
    <VBox styleClass="tela-formulario">
        <VBox styleClass="painel-formulario">
            <GridPane vgap="10" hgap="12">
                <columnConstraints>
                    <ColumnConstraints minWidth="150" prefWidth="170"/>
                    <ColumnConstraints minWidth="230" prefWidth="300"/>
                    <ColumnConstraints minWidth="130" prefWidth="150"/>
                </columnConstraints>

                <Label text="Placa" styleClass="rotulo-campo"/>
                <TextField fx:id="campoPlaca" styleClass="campo-texto" GridPane.columnIndex="1" />
                <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#buscarVeiculo" styleClass="btn-secundario" text="Buscar" GridPane.columnIndex="2" />

                <Label text="Cliente" GridPane.rowIndex="2" styleClass="rotulo-campo"/>
                <Label fx:id="labelCliente" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="rotulo-resultado"/>

                <Label text="Retirada" GridPane.rowIndex="3" styleClass="rotulo-campo"/>
                <Label fx:id="labelRetirada" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="rotulo-resultado"/>

                <Label text="Devolucao Prevista" GridPane.rowIndex="4" styleClass="rotulo-campo"/>
                <Label fx:id="labelDevolucao" text="-" GridPane.columnIndex="1" GridPane.rowIndex="4" styleClass="rotulo-resultado"/>

                <Label text="Valor Original" GridPane.rowIndex="5" styleClass="rotulo-campo"/>
                <Label fx:id="labelValor" text="R$ 0,00" GridPane.columnIndex="1" GridPane.rowIndex="5" styleClass="rotulo-resultado"/>

                <Label text="Dias de Atraso" GridPane.rowIndex="6" styleClass="rotulo-campo"/>
                <Label fx:id="labelAtraso" text="0" GridPane.columnIndex="1" GridPane.rowIndex="6" styleClass="rotulo-resultado"/>

                <Label text="Multa" GridPane.rowIndex="7" styleClass="rotulo-campo"/>
                <Label fx:id="labelMulta" text="R$ 0,00" GridPane.columnIndex="1" GridPane.rowIndex="7" styleClass="rotulo-resultado"/>

                <Label text="Valor Final" GridPane.rowIndex="8" styleClass="rotulo-campo"/>
                <Label fx:id="labelValorFinal" text="R$ 0,00" GridPane.columnIndex="1" GridPane.rowIndex="8" styleClass="rotulo-resultado"/>
            </GridPane>

            <HBox styleClass="linha-btn">
                <Button fx:id="btnDevolucao" mnemonicParsing="false" onAction="#confirmarDevolucao" styleClass="btn-primario" text="Confirmar Devolucao" GridPane.columnIndex="1" GridPane.rowIndex="10" />
                <Button fx:id="btnVoltar" mnemonicParsing="false" onAction="#voltar" styleClass="btn-secundario" text="Voltar" />
            </HBox>
        </VBox>
    </VBox>
</VBox>
