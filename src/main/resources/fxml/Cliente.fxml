<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER"
      spacing="20"
      styleClass="home-conteudo"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.br.ifg.luziania.trabalho_p3.controller.ClienteController">

    <VBox styleClass="tela-formulario">

        <!-- Cabeçalho da tela -->
        <HBox alignment="CENTER_LEFT" styleClass="cabecalho-tela">
            <VBox HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="👤" styleClass="icone-titulo" />
                    <Label styleClass="titulo-tela" text="Gerenciamento de Clientes" />
                </HBox>

                <Label styleClass="subtitulo-tela"
                       text="Cadastre, atualize, inative e consulte clientes da locadora." />
            </VBox>

            <Button fx:id="btnVoltar"
                    onAction="#voltarAction"
                    styleClass="btn-secundario"
                    text="← Voltar" />
        </HBox>

        <!-- Formulário de cadastro e edição -->
        <VBox spacing="20" styleClass="painel-formulario">
            <GridPane hgap="20" vgap="15">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" />
                    <ColumnConstraints percentWidth="50" />
                </columnConstraints>

                <VBox spacing="5">
                    <Label styleClass="rotulo-campo" text="Nome Completo" />
                    <TextField fx:id="campoNome"
                               promptText="Ex: João Silva"
                               styleClass="campo-texto" />
                </VBox>

                <VBox spacing="5" GridPane.columnIndex="1">
                    <Label styleClass="rotulo-campo" text="E-mail" />
                    <TextField fx:id="campoEmail"
                               promptText="joao@email.com"
                               styleClass="campo-texto" />
                </VBox>

                <VBox spacing="5" GridPane.rowIndex="1">
                    <Label styleClass="rotulo-campo" text="CPF" />
                    <TextField fx:id="campoCpf"
                               promptText="000.000.000-00"
                               styleClass="campo-texto" />
                </VBox>

                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label styleClass="rotulo-campo" text="CNH" />
                    <TextField fx:id="campoCnh"
                               promptText="11 dígitos"
                               styleClass="campo-texto" />
                </VBox>

                <VBox spacing="5" GridPane.rowIndex="2">
                    <Label styleClass="rotulo-campo" text="Telefone" />
                    <TextField fx:id="campoTelefone"
                               promptText="(61) 99999-9999"
                               styleClass="campo-texto" />
                </VBox>
            </GridPane>

            <!-- Ações do formulário -->
            <HBox spacing="15" alignment="CENTER_LEFT" styleClass="linha-btn">
                <Button fx:id="btnSalvar"
                        onAction="#salvar"
                        styleClass="btn-primario"
                        text="💾 Salvar Cliente" />

                <Button fx:id="btnAtualizar"
                        onAction="#atualizar"
                        styleClass="btn-secundario"
                        text="✏ Atualizar" />

                <Button fx:id="btnInativar"
                        onAction="#inativar"
                        styleClass="btn-perigo"
                        text="🚫 Inativar" />

                <Button fx:id="btnLimpar"
                        onAction="#limpar"
                        styleClass="btn-secundario"
                        text="🧹 Limpar" />
            </HBox>
        </VBox>

        <!-- Área de busca e listagem -->
        <VBox spacing="15" styleClass="bloco-tabela">
            <VBox spacing="5">
                <Label styleClass="rotulo-busca" text="Buscar cliente" />
                <TextField fx:id="campoBusca"
                           promptText="Busque por nome, CPF, CNH, telefone, e-mail ou status..."
                           styleClass="campo-texto" />
            </VBox>

            <!-- Tabela de clientes -->
            <TableView fx:id="tabelaCliente"
                       prefHeight="300"
                       styleClass="tabela-padrao">
                <columns>
                    <TableColumn fx:id="colunaNome" prefWidth="250" text="Nome" />
                    <TableColumn fx:id="colunaCpf" prefWidth="130" text="CPF" />
                    <TableColumn fx:id="colunaEmail" prefWidth="200" text="E-mail" />
                    <TableColumn fx:id="colunaCnh" prefWidth="110" text="CNH" />
                    <TableColumn fx:id="colunaTelefone" prefWidth="130" text="Telefone" />
                    <TableColumn fx:id="colunaAtivo" prefWidth="80" text="Status" />
                </columns>

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>
</VBox>