<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER"
      prefHeight="720"
      prefWidth="1100"
      spacing="0"
      styleClass="pagina"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.br.ifg.luziania.trabalho_p3.controller.ClienteController">

    <VBox styleClass="tela-formulario">

        <!-- Caballero da tela -->
        <VBox styleClass="cabecalho-tela">
            <Label styleClass="titulo-tela" text="Gerenciamento de Clientes" />
            <Label styleClass="subtitulo-tela" text="Cadastre, atualize, inative e consulte clientes da locadora." />
        </VBox>

        <!-- Formulário de cadastro/edição -->
        <VBox styleClass="painel-formulario">
            <GridPane hgap="12" vgap="10">
                <Label styleClass="rotulo-campo" text="Nome" />
                <TextField fx:id="campoNome" promptText="Nome completo" styleClass="campo-texto" GridPane.columnIndex="1" />

                <Label styleClass="rotulo-campo" text="CPF" GridPane.rowIndex="1" />
                <TextField fx:id="campoCpf" promptText="000.000.000-00" styleClass="campo-texto" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label styleClass="rotulo-campo" text="CNH" GridPane.rowIndex="2" />
                <TextField fx:id="campoCnh" promptText="11 dígitos" styleClass="campo-texto" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label styleClass="rotulo-campo" text="Telefone" GridPane.rowIndex="3" />
                <TextField fx:id="campoTelefone" promptText="(61) 99999-9999" styleClass="campo-texto" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label styleClass="rotulo-campo" text="E-mail" GridPane.rowIndex="4" />
                <TextField fx:id="campoEmail" promptText="cliente@email.com" styleClass="campo-texto" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                <columnConstraints>
                    <ColumnConstraints minWidth="100" />
                    <ColumnConstraints hgrow="ALWAYS" />
                </columnConstraints>

                <rowConstraints>
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                </rowConstraints>
            </GridPane>

            <!-- Botões principals da tela -->
            <HBox styleClass="linha-btn">
                <Button fx:id="btnSalvar" mnemonicParsing="false" onAction="#salvar" styleClass="btn-primario" text="Salvar" />
                <Button fx:id="btnAtualizar" mnemonicParsing="false" onAction="#atualizar" styleClass="btn-secundario" text="Atualizar" />
                <Button fx:id="btnInativar" mnemonicParsing="false" onAction="#inativar" styleClass="btn-perigo" text="Inativar" />
                <Button fx:id="btnLimpar" mnemonicParsing="false" onAction="#limpar" styleClass="btn-secundario" text="Limpar" />
                <Button fx:id="btnVoltar" mnemonicParsing="false" onAction="#voltar" styleClass="btn-secundario" text="Voltar" />
            </HBox>
        </VBox>

        <!-- Área de busca e staged -->
        <VBox spacing="10" styleClass="bloco-tabela">
            <HBox spacing="10" styleClass="linha-busca">
                <Label styleClass="rotulo-busca" text="Buscar:" />
                <TextField fx:id="campoBusca" promptText="Nome, CPF, CNH, telefone ou e-mail" styleClass="campo-texto" HBox.hgrow="ALWAYS" />
            </HBox>

            <TableView fx:id="tabelaCliente" prefHeight="240" maxWidth="-Infinity" styleClass="tabela-padrao">
                <columns>
                    <TableColumn fx:id="colunaNome" prefWidth="170" text="Nome" />
                    <TableColumn fx:id="colunaCpf" prefWidth="115" text="CPF" />
                    <TableColumn fx:id="colunaCnh" prefWidth="110" text="CNH" />
                    <TableColumn fx:id="colunaTelefone" prefWidth="130" text="Telefone" />
                    <TableColumn fx:id="colunaEmail" prefWidth="190" text="E-mail" />
                    <TableColumn fx:id="colunaAtivo" prefWidth="80" text="Ativo" />
                </columns>
            </TableView>
        </VBox>
    </VBox>
</VBox>
