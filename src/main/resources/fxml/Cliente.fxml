<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.*?>

<VBox alignment="TOP_CENTER" spacing="20" styleClass="home-conteudo" stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.br.ifg.luziania.trabalho_p3.controller.ClienteController">

    <VBox styleClass="tela-formulario">
        <!-- Cabeçalho -->
        <HBox alignment="CENTER_LEFT" styleClass="cabecalho-tela">
            <VBox HBox.hgrow="ALWAYS">
                <Label styleClass="titulo-tela" text="Gerenciamento de Clientes" />
                <Label styleClass="subtitulo-tela" text="Mantenha a base de dados de seus clientes sempre atualizada." />
            </VBox>
            <Button fx:id="btnVoltar" onAction="#voltarAction" styleClass="btn-secundario" text="Voltar">
                <graphic><FontIcon iconLiteral="fas-arrow-left"/></graphic>
            </Button>
        </HBox>

        <!-- Formulário -->
        <VBox spacing="20" styleClass="painel-formulario">
            <GridPane hgap="20" vgap="15">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" />
                    <ColumnConstraints percentWidth="50" />
                </columnConstraints>

                <VBox spacing="5">
                    <Label styleClass="rotulo-campo" text="Nome Completo" />
                    <TextField fx:id="campoNome" promptText="Ex: João Silva" styleClass="campo-texto" />
                </VBox>

                <VBox spacing="5" GridPane.columnIndex="1">
                    <Label styleClass="rotulo-campo" text="E-mail" />
                    <TextField fx:id="campoEmail" promptText="joao@email.com" styleClass="campo-texto" />
                </VBox>

                <VBox spacing="5" GridPane.rowIndex="1">
                    <Label styleClass="rotulo-campo" text="CPF" />
                    <TextField fx:id="campoCpf" promptText="000.000.000-00" styleClass="campo-texto" />
                </VBox>

                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label styleClass="rotulo-campo" text="CNH" />
                    <TextField fx:id="campoCnh" promptText="11 dígitos" styleClass="campo-texto" />
                </VBox>

                <VBox spacing="5" GridPane.rowIndex="2">
                    <Label styleClass="rotulo-campo" text="Telefone" />
                    <TextField fx:id="campoTelefone" promptText="(61) 99999-9999" styleClass="campo-texto" />
                </VBox>
            </GridPane>

            <HBox spacing="15" alignment="CENTER_LEFT">
                <Button fx:id="btnSalvar" onAction="#salvar" styleClass="btn-primario" text="Salvar Cliente">
                    <graphic><FontIcon iconLiteral="fas-save" iconColor="white"/></graphic>
                </Button>
                <Button fx:id="btnAtualizar" onAction="#atualizar" styleClass="btn-secundario" text="Atualizar">
                    <graphic><FontIcon iconLiteral="fas-edit"/></graphic>
                </Button>
                <Button fx:id="btnInativar" onAction="#inativar" styleClass="btn-perigo" text="Inativar">
                    <graphic><FontIcon iconLiteral="fas-user-slash"/></graphic>
                </Button>
                <Button fx:id="btnLimpar" onAction="#limpar" styleClass="btn-secundario" text="Limpar Campos">
                    <graphic><FontIcon iconLiteral="fas-eraser"/></graphic>
                </Button>
            </HBox>
        </VBox>

        <!-- Busca e Listagem -->
        <VBox spacing="15" styleClass="bloco-tabela">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <VBox HBox.hgrow="ALWAYS" spacing="5">
                    <Label styleClass="rotulo-busca" text="Filtrar Clientes" />
                    <TextField fx:id="campoBusca" promptText="Busque por nome, CPF ou e-mail..." styleClass="campo-texto" />
                </VBox>
            </HBox>

            <TableView fx:id="tabelaCliente" prefHeight="300" styleClass="tabela-padrao">
                <columns>
                    <TableColumn fx:id="colunaNome" prefWidth="250" text="Nome" />
                    <TableColumn fx:id="colunaCpf" prefWidth="130" text="CPF" />
                    <TableColumn fx:id="colunaEmail" prefWidth="200" text="E-mail" />
                    <TableColumn fx:id="colunaCnh" prefWidth="110" text="CNH" />
                    <TableColumn fx:id="colunaTelefone" prefWidth="130" text="Telefone" />
                    <TableColumn fx:id="colunaAtivo" prefWidth="80" text="Status" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>
</VBox>
