<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="600.0"
           prefWidth="800.0"
           styleClass="login-root"
           stylesheets="@../css/estilos.css"
           xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.br.ifg.luziania.trabalho_p3.controller.LoginController">

   <!-- Cartão central de autenticação -->
   <VBox alignment="CENTER"
         maxWidth="400"
         spacing="25"
         styleClass="cartao-login">

      <!-- Cabeçalho do login -->
      <VBox alignment="CENTER" spacing="10">
         <StackPane styleClass="icone-login">
            <Label text="🚗" styleClass="icone-login-texto" />
         </StackPane>

         <Label text="Locadora" styleClass="titulo-login" />
         <Label text="Gestão de Frotas e Locações" styleClass="subtitulo-tela" />
      </VBox>

      <!-- Campos de acesso -->
      <VBox spacing="15">
         <VBox spacing="5">
            <Label text="E-mail" styleClass="rotulo-campo-login" />
            <TextField fx:id="campoEmail"
                       promptText="seu@email.com"
                       styleClass="campo-texto" />
         </VBox>

         <VBox spacing="5">
            <Label text="Senha" styleClass="rotulo-campo-login" />
            <PasswordField fx:id="campoSenha"
                           promptText="••••••••"
                           styleClass="campo-texto" />
         </VBox>
      </VBox>

      <!-- Ação principal -->
      <Button fx:id="btnEntrar"
              defaultButton="true"
              maxWidth="Infinity"
              mnemonicParsing="false"
              onAction="#fazerLogin"
              styleClass="btn-primario"
              text="Entrar no sistema" />

      <!-- Rodapé -->
      <Label text="IFG - Programação III" styleClass="subtitulo-tela" />
   </VBox>
</StackPane>