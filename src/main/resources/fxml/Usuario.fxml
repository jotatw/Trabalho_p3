<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER"
      spacing="20"
      styleClass="home-conteudo"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.br.ifg.luziania.trabalho_p3.controller.UsuarioController">

    <VBox styleClass="tela-formulario">

        <!-- Cabeçalho da tela -->
        <HBox alignment="CENTER_LEFT" styleClass="cabecalho-tela">
            <VBox HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="🔐" styleClass="icone-titulo" />
                    <Label styleClass="titulo-tela" text="Gestão de Usuários" />
                </HBox>

                <Label styleClass="subtitulo-tela"
                       text="Controle quem pode acessar as funcionalidades do sistema." />
            </VBox>

            <Button fx:id="btnVoltar"
                    onAction="#voltarAction"
                    styleClass="btn-secundario"
                    text="← Voltar" />
        </HBox>

        <!-- Formulário de cadastro e edição -->
        <VBox spacing="20" styleClass="painel-formulario">
            <GridPane hgap="20" vgap="15">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" />
                    <ColumnConstraints percentWidth="50" />
                </columnConstraints>

                <VBox spacing="5">
                    <Label styleClass="rotulo-campo" text="Nome Completo" />
                    <TextField fx:id="campoNome"
                               promptText="Nome do funcionário"
                               styleClass="campo-texto" />
                </VBox>

                <VBox spacing="5" GridPane.columnIndex="1">
                    <Label styleClass="rotulo-campo" text="E-mail" />
                    <TextField fx:id="campoEmail"
                               promptText="usuario@locadora.com"
                               styleClass="campo-texto" />
                </VBox>

                <VBox spacing="5" GridPane.rowIndex="1">
                    <Label styleClass="rotulo-campo" text="Senha" />
                    <PasswordField fx:id="campoSenha"
                                   promptText="Mínimo 6 caracteres"
                                   styleClass="campo-texto" />
                </VBox>

                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label styleClass="rotulo-campo" text="Perfil de Acesso" />
                    <ComboBox fx:id="cmbPerfil"
                              maxWidth="Infinity"
                              promptText="Selecione o nível"
                              styleClass="campo-texto" />
                </VBox>
            </GridPane>

            <!-- Ações do formulário -->
            <HBox spacing="15" alignment="CENTER_LEFT" styleClass="linha-btn">
                <Button fx:id="btnSalvar"
                        onAction="#salvar"
                        styleClass="btn-primario"
                        text="💾 Criar Usuário" />

                <Button fx:id="btnAtualizar"
                        onAction="#atualizar"
                        styleClass="btn-secundario"
                        text="✏ Atualizar" />

                <Button fx:id="btnInativar"
                        onAction="#inativar"
                        styleClass="btn-perigo"
                        text="🚫 Desativar" />

                <Button onAction="#limpar"
                        styleClass="btn-secundario"
                        text="🧹 Limpar" />
            </HBox>
        </VBox>

        <!-- Área de busca e listagem -->
        <VBox spacing="15" styleClass="bloco-tabela">
            <VBox spacing="5">
                <Label styleClass="rotulo-busca" text="Buscar usuário" />
                <TextField fx:id="campoBusca"
                           promptText="Filtrar por nome, e-mail, perfil ou status..."
                           styleClass="campo-texto" />
            </VBox>

            <!-- Tabela de usuários -->
            <TableView fx:id="tabelaUsuario"
                       prefHeight="300"
                       styleClass="tabela-padrao">
                <columns>
                    <TableColumn fx:id="tabelaNome" prefWidth="250" text="Nome" />
                    <TableColumn fx:id="tabelaEmail" prefWidth="250" text="E-mail" />
                    <TableColumn fx:id="tabelaPerfil" prefWidth="150" text="Perfil" />
                    <TableColumn fx:id="tabelaAtivo" prefWidth="100" text="Ativo" />
                </columns>

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>
</VBox>