<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox alignment="TOP_CENTER" spacing="20" styleClass="home-conteudo" stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.br.ifg.luziania.trabalho_p3.controller.UsuarioController">

    <VBox styleClass="tela-formulario">
        <HBox alignment="CENTER_LEFT" styleClass="cabecalho-tela">
            <VBox HBox.hgrow="ALWAYS">
                <Label styleClass="titulo-tela" text="Gestão de Usuários" />
                <Label styleClass="subtitulo-tela" text="Controle quem pode acessar as funcionalidades do sistema." />
            </VBox>
            <Button fx:id="btnVoltar" onAction="#voltarAction" styleClass="btn-secundario" text="Voltar">
                <graphic><FontIcon iconLiteral="fas-arrow-left"/></graphic>
            </Button>
        </HBox>

        <VBox spacing="20" styleClass="painel-formulario">
            <GridPane hgap="20" vgap="15">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" />
                    <ColumnConstraints percentWidth="50" />
                </columnConstraints>

                <VBox spacing="5">
                    <Label styleClass="rotulo-campo" text="Nome Completo" />
                    <TextField fx:id="campoNome" promptText="Nome do funcionário" styleClass="campo-texto" />
                </VBox>

                <VBox spacing="5" GridPane.columnIndex="1">
                    <Label styleClass="rotulo-campo" text="E-mail" />
                    <TextField fx:id="campoEmail" promptText="usuario@locadora.com" styleClass="campo-texto" />
                </VBox>

                <VBox spacing="5" GridPane.rowIndex="1">
                    <Label styleClass="rotulo-campo" text="Senha" />
                    <PasswordField fx:id="campoSenha" promptText="Mínimo 6 caracteres" styleClass="campo-texto" />
                </VBox>

                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label styleClass="rotulo-campo" text="Perfil de Acesso" />
                    <ComboBox fx:id="cmbPerfil" maxWidth="Infinity" promptText="Selecione o nível" styleClass="combo-box" />
                </VBox>
            </GridPane>

            <HBox spacing="15" alignment="CENTER_LEFT">
                <Button fx:id="btnSalvar" onAction="#salvar" styleClass="btn-primario" text="Criar Usuário">
                    <graphic><FontIcon iconLiteral="fas-user-plus" iconColor="white"/></graphic>
                </Button>
                <Button fx:id="btnAtualizar" onAction="#atualizar" styleClass="btn-secundario" text="Atualizar">
                    <graphic><FontIcon iconLiteral="fas-user-edit"/></graphic>
                </Button>
                <Button fx:id="btnInativar" onAction="#inativar" styleClass="btn-perigo" text="Desativar">
                    <graphic><FontIcon iconLiteral="fas-user-lock"/></graphic>
                </Button>
            </HBox>
        </VBox>

        <VBox spacing="15" styleClass="bloco-tabela">
             <HBox alignment="CENTER_LEFT" spacing="15">
                <VBox HBox.hgrow="ALWAYS" spacing="5">
                    <Label styleClass="rotulo-busca" text="Buscar Usuário" />
                    <TextField fx:id="campoBusca" promptText="Filtrar por nome ou e-mail..." styleClass="campo-texto" />
                </VBox>
            </HBox>

            <TableView fx:id="tabelaUsuario" prefHeight="300" styleClass="tabela-padrao">
                <columns>
                    <TableColumn fx:id="tabelaNome" prefWidth="250" text="Nome" />
                    <TableColumn fx:id="tabelaEmail" prefWidth="250" text="E-mail" />
                    <TableColumn fx:id="tabelaPerfil" prefWidth="150" text="Perfil" />
                    <TableColumn fx:id="tabelaAtivo" prefWidth="100" text="Ativo" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>
</VBox>
