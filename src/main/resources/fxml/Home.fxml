<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="1100"
            prefHeight="720"
            styleClass="pagina"
            stylesheets="@../css/estilos.css"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.br.ifg.luziania.trabalho_p3.controller.HomeController">
   <left>
      <VBox prefWidth="220" spacing="8" styleClass="sidebar">
         <children>
            <Label styleClass="sidebar-titulo" text="MENU" />
            <Button fx:id="btnVeiculos" mnemonicParsing="false" onAction="#abrirVeiculos" styleClass="nav-btn" text="Veículos" />
            <Button fx:id="btnClientes" mnemonicParsing="false" onAction="#abrirClientes" styleClass="nav-btn" text="Clientes" />
            <Button fx:id="btnLocacao" mnemonicParsing="false" onAction="#abrirLocacao" styleClass="nav-btn" text="Nova Locação" />
            <Button fx:id="btnDevolucao" mnemonicParsing="false" onAction="#abrirDevolucao" styleClass="nav-btn" text="Devoluções" />
            <Button fx:id="btnUsuarios" mnemonicParsing="false" onAction="#abrirUsuarios" styleClass="nav-btn" text="Usuários" />
            <Pane VBox.vgrow="ALWAYS" />
            <Button fx:id="btnSair" mnemonicParsing="false" onAction="#sair" styleClass="nav-btn-sair" text="Sair" />
         </children>
      </VBox>
   </left>
   <center>
      <StackPane styleClass="area-home">
         <VBox spacing="24" styleClass="home-conteudo">

            <!-- Cabeçalho da Home -->
            <VBox spacing="6" styleClass="home-cabecalho">
               <Label text="Painel Inicial" styleClass="home-titulo" />

               <Label fx:id="labelBoasVindas"
                      text="Bem-vindo ao sistema"
                      styleClass="home-subtitulo" />

               <Label fx:id="labelPerfil"
                      text="Perfil: -"
                      styleClass="home-perfil" />
            </VBox>

            <!-- Cards visuais temporários -->
            <HBox spacing="16" styleClass="home-cards">
               <VBox styleClass="card-home">
                  <Label text="Clientes" styleClass="card-home-titulo" />
                  <Label text="Ativos" styleClass="card-home-subtitulo" />
               </VBox>

               <VBox styleClass="card-home">
                  <Label text="Veículos" styleClass="card-home-titulo" />
                  <Label text="Disponíveis" styleClass="card-home-subtitulo" />
               </VBox>

               <VBox styleClass="card-home">
                  <Label text="Locações" styleClass="card-home-titulo" />
                  <Label text="Em andamento" styleClass="card-home-subtitulo" />
               </VBox>
            </HBox>

            <!-- Ações rápidas -->
            <VBox spacing="12" styleClass="home-secao">
               <Label text="Ações rápidas" styleClass="home-secao-titulo" />

               <HBox spacing="12">
                  <Button fx:id="btnAtalhoLocacao"
                          text="Nova Locação"
                          onAction="#abrirLocacao"
                          styleClass="btn-primario" />

                  <Button fx:id="btnAtalhoDevolucao"
                          text="Registrar Devolução"
                          onAction="#abrirDevolucao"
                          styleClass="btn-secundario" />

                  <Button fx:id="btnAtalhoCliente"
                          text="Cadastrar Cliente"
                          onAction="#abrirClientes"
                          styleClass="btn-secundario" />

                  <Button fx:id="btnAtalhoVeiculo"
                          text="Cadastrar Veículo"
                          onAction="#abrirVeiculos"
                          styleClass="btn-secundario" />
               </HBox>
            </VBox>

            <!-- Área informativa -->
            <VBox spacing="8" styleClass="home-info">
               <Label text="Resumo do sistema" styleClass="home-secao-titulo" />
               <Label text="Use o menu lateral ou os atalhos acima para acessar as principais funções da locadora."
                      styleClass="home-texto" />
            </VBox>

         </VBox>
      </StackPane>
   </center>
</BorderPane>
