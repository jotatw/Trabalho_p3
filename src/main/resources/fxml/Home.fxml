<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="1200"
            prefHeight="800"
            styleClass="pagina"
            stylesheets="@../css/estilos.css"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.br.ifg.luziania.trabalho_p3.controller.HomeController">

    <!-- Menu lateral -->
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar">

            <!-- Logo e botão de recolher menu -->
            <HBox alignment="CENTER_LEFT"
                  spacing="10"
                  styleClass="sidebar-logo-container">
                <Button onAction="#toggleSidebar"
                        styleClass="nav-btn"
                        text="☰" />

                <Label fx:id="labelLogo"
                       styleClass="sidebar-titulo"
                       text="LOCADORA" />
            </HBox>

            <!-- Navegação principal -->
            <Button fx:id="btnHome"
                    mnemonicParsing="false"
                    styleClass="nav-btn, ativo"
                    text="📊 Dashboard" />

            <Button fx:id="btnVeiculos"
                    mnemonicParsing="false"
                    onAction="#abrirVeiculos"
                    styleClass="nav-btn"
                    text="🚙 Veículos" />

            <Button fx:id="btnClientes"
                    mnemonicParsing="false"
                    onAction="#abrirClientes"
                    styleClass="nav-btn"
                    text="👤 Clientes" />

            <Button fx:id="btnLocacao"
                    mnemonicParsing="false"
                    onAction="#abrirLocacao"
                    styleClass="nav-btn"
                    text="📝 Nova Locação" />

            <Button fx:id="btnDevolucao"
                    mnemonicParsing="false"
                    onAction="#abrirDevolucao"
                    styleClass="nav-btn"
                    text="↩ Devoluções" />

            <Button fx:id="btnUsuarios"
                    mnemonicParsing="false"
                    onAction="#abrirUsuarios"
                    styleClass="nav-btn"
                    text="🔐 Usuários" />

            <Pane VBox.vgrow="ALWAYS" />

            <!-- Saída do sistema -->
            <Button fx:id="btnSair"
                    mnemonicParsing="false"
                    onAction="#sair"
                    styleClass="nav-btn, nav-btn-sair"
                    text="🚪 Sair" />
        </VBox>
    </left>

    <!-- Conteúdo principal -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="area-home">
            <VBox spacing="30" styleClass="home-conteudo">

                <!-- Cabeçalho do dashboard -->
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label fx:id="labelBoasVindas"
                               text="Olá, Usuário"
                               styleClass="titulo-tela" />

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Perfil:" styleClass="subtitulo-tela" />
                            <Label fx:id="labelPerfil"
                                   text="ADMIN"
                                   styleClass="perfil-usuario" />
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Cards de resumo -->
                <HBox spacing="20">
                    <VBox styleClass="card-home" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <StackPane styleClass="card-icone, card-icone-azul">
                                <Label text="👤" styleClass="card-icone-texto" />
                            </StackPane>

                            <VBox>
                                <Label text="Clientes Ativos" styleClass="card-home-titulo" />
                                <Label fx:id="labelClientesAtivos" text="0" styleClass="card-home-numero" />
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox styleClass="card-home" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <StackPane styleClass="card-icone, card-icone-verde">
                                <Label text="🚙" styleClass="card-icone-texto" />
                            </StackPane>

                            <VBox>
                                <Label text="Veículos Disponíveis" styleClass="card-home-titulo" />
                                <Label fx:id="labelVeiculosDisponiveis" text="0" styleClass="card-home-numero" />
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox styleClass="card-home" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <StackPane styleClass="card-icone, card-icone-amarelo">
                                <Label text="📝" styleClass="card-icone-texto" />
                            </StackPane>

                            <VBox>
                                <Label text="Locações Ativas" styleClass="card-home-titulo" />
                                <Label fx:id="labelLocacoesAtivas" text="0" styleClass="card-home-numero" />
                            </VBox>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Tabela de locações ativas -->
                <VBox spacing="15" styleClass="tela-formulario">
                    <HBox alignment="CENTER_LEFT" styleClass="cabecalho-tela">
                        <VBox HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="📌" styleClass="icone-titulo" />
                                <Label text="Locações em Andamento" styleClass="titulo-secao" />
                            </HBox>

                            <Label text="Acompanhe os veículos que ainda estão em uso."
                                   styleClass="subtitulo-tela" />
                        </VBox>

                        <Button styleClass="btn-primario"
                                text="Nova Locação"
                                onAction="#abrirLocacao" />
                    </HBox>

                    <VBox styleClass="bloco-tabela">
                        <TableView fx:id="tabelaLocacoesAtivas"
                                   prefHeight="300"
                                   styleClass="tabela-padrao">
                            <columns>
                                <TableColumn fx:id="colunaClienteLocacao" text="Cliente" prefWidth="300" />
                                <TableColumn fx:id="colunaVeiculoLocacao" text="Veículo" prefWidth="200" />
                                <TableColumn fx:id="colunaPlacaLocacao" text="Placa" prefWidth="120" />
                                <TableColumn fx:id="colunaDevolucaoLocacao" text="Data Devolução" prefWidth="150" />
                            </columns>

                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>