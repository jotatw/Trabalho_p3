<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.br.ifg.luziania.trabalho_p3.controller.VeiculoController"
      stylesheets="@../css/estilos.css"
      styleClass="pagina"
      alignment="TOP_CENTER"
      spacing="0">

    <VBox styleClass="tela-formulario">
        <VBox styleClass="painel-formulario">
            <GridPane hgap="12" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="120" prefWidth="140"/>
                    <ColumnConstraints minWidth="260" prefWidth="320" hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Placa" styleClass="rotulo-campo"/>
                <TextField fx:id="campoPlaca" styleClass="campo-texto" GridPane.columnIndex="1"/>

                <Label text="Modelo" styleClass="rotulo-campo" GridPane.rowIndex="1"/>
                <TextField fx:id="campoModelo" styleClass="campo-texto" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Marca" styleClass="rotulo-campo" GridPane.rowIndex="2"/>
                <TextField fx:id="campoMarca" styleClass="campo-texto" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Categoria" styleClass="rotulo-campo" GridPane.rowIndex="3"/>
                <TextField fx:id="campoCategoria" styleClass="campo-texto" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Valor da diária" styleClass="rotulo-campo" GridPane.rowIndex="4"/>
                <TextField fx:id="campoValor" styleClass="campo-texto" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                <CheckBox fx:id="ckbDisponivel"
                          text="Disponível"
                          mnemonicParsing="false"
                          styleClass="rotulo-campo"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="5"/>
            </GridPane>

            <HBox styleClass="linha-botoes">
                <Button fx:id="btnSalvar" text="Salvar" onAction="#salvar" mnemonicParsing="false" styleClass="botao-primario"/>
                <Button fx:id="btnLimpar" text="Limpar" onAction="#limpar" mnemonicParsing="false" styleClass="botao-secundario"/>
                <Button fx:id="btnVoltar" text="Voltar" onAction="#voltar" mnemonicParsing="false" styleClass="botao-secundario"/>
            </HBox>
        </VBox>

        <VBox styleClass="bloco-tabela">
            <TableView fx:id="tabelaVeiculo" styleClass="tabela-padrao" prefHeight="260">
                <columns>
                    <TableColumn fx:id="colunaPlaca" text="Placa" prefWidth="110"/>
                    <TableColumn fx:id="colunaModelo" text="Modelo" prefWidth="140"/>
                    <TableColumn fx:id="colunaMarca" text="Marca" prefWidth="130"/>
                    <TableColumn fx:id="colunaCategoria" text="Categoria" prefWidth="130"/>
                    <TableColumn fx:id="colunaValor" text="Valor da Diária" prefWidth="180"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</VBox>