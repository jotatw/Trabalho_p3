<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER"
      spacing="20"
      styleClass="home-conteudo"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.br.ifg.luziania.trabalho_p3.controller.VeiculoController">

    <VBox styleClass="tela-formulario">

        <!-- Cabeçalho da tela -->
        <HBox alignment="CENTER_LEFT" styleClass="cabecalho-tela">
            <VBox HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="🚙" styleClass="icone-titulo" />
                    <Label styleClass="titulo-tela" text="Frota de Veículos" />
                </HBox>

                <Label styleClass="subtitulo-tela"
                       text="Cadastre veículos e gerencie a disponibilidade da frota." />
            </VBox>

            <Button fx:id="btnVoltar"
                    onAction="#voltarAction"
                    styleClass="btn-secundario"
                    text="← Voltar" />
        </HBox>

        <!-- Formulário de cadastro e edição -->
        <VBox spacing="20" styleClass="painel-formulario">
            <GridPane hgap="20" vgap="15">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33" />
                    <ColumnConstraints percentWidth="33" />
                    <ColumnConstraints percentWidth="34" />
                </columnConstraints>

                <VBox spacing="5">
                    <Label styleClass="rotulo-campo" text="Marca" />
                    <TextField fx:id="campoMarca"
                               promptText="Ex: Toyota"
                               styleClass="campo-texto" />
                </VBox>

                <VBox spacing="5" GridPane.columnIndex="1">
                    <Label styleClass="rotulo-campo" text="Modelo" />
                    <TextField fx:id="campoModelo"
                               promptText="Ex: Corolla"
                               styleClass="campo-texto" />
                </VBox>

                <VBox spacing="5" GridPane.columnIndex="2">
                    <Label styleClass="rotulo-campo" text="Placa" />
                    <TextField fx:id="campoPlaca"
                               promptText="ABC1D23"
                               styleClass="campo-texto" />
                </VBox>

                <VBox spacing="5" GridPane.rowIndex="1">
                    <Label styleClass="rotulo-campo" text="Categoria" />
                    <ComboBox fx:id="comboCategoria"
                              maxWidth="Infinity"
                              promptText="Selecione"
                              styleClass="campo-texto" />
                </VBox>

                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label styleClass="rotulo-campo" text="Valor da Diária (R$)" />
                    <TextField fx:id="campoValor"
                               promptText="0.00"
                               styleClass="campo-texto" />
                </VBox>
            </GridPane>

            <!-- Ações do formulário -->
            <HBox spacing="15" alignment="CENTER_LEFT" styleClass="linha-btn">
                <Button onAction="#salvar"
                        styleClass="btn-primario"
                        text="💾 Cadastrar Veículo" />

                <Button fx:id="btnAtualizar"
                        onAction="#atualizar"
                        styleClass="btn-secundario"
                        text="✏ Atualizar" />

                <Button onAction="#limpar"
                        styleClass="btn-secundario"
                        text="🧹 Limpar" />
            </HBox>
        </VBox>

        <!-- Área de busca e listagem -->
        <VBox spacing="15" styleClass="bloco-tabela">
            <VBox spacing="5">
                <Label styleClass="rotulo-busca" text="Buscar veículo" />
                <TextField fx:id="campoBusca"
                           promptText="Busque por placa, modelo, marca, categoria ou status..."
                           styleClass="campo-texto" />
            </VBox>

            <!-- Tabela de veículos -->
            <TableView fx:id="tabelaVeiculo"
                       prefHeight="300"
                       styleClass="tabela-padrao">
                <columns>
                    <TableColumn fx:id="colunaPlaca" prefWidth="100" text="Placa" />
                    <TableColumn fx:id="colunaMarca" prefWidth="120" text="Marca" />
                    <TableColumn fx:id="colunaModelo" prefWidth="150" text="Modelo" />
                    <TableColumn fx:id="colunaCategoria" prefWidth="120" text="Categoria" />
                    <TableColumn fx:id="colunaValor" prefWidth="110" text="Diária" />
                    <TableColumn fx:id="colunaDisponivel" prefWidth="100" text="Status" />
                </columns>

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>
</VBox>