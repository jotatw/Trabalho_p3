<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" spacing="0" styleClass="pagina" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.br.ifg.luziania.trabalho_p3.controller.VeiculoController">

    <VBox styleClass="tela-formulario">
        <VBox styleClass="painel-formulario">
            <GridPane hgap="12" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="120" prefWidth="140" />
                    <ColumnConstraints hgrow="ALWAYS" minWidth="260" prefWidth="320" />
                </columnConstraints>

                <Label styleClass="rotulo-campo" text="Placa" />
                <TextField fx:id="campoPlaca" styleClass="campo-texto" GridPane.columnIndex="1" />

                <Label styleClass="rotulo-campo" text="Modelo" GridPane.rowIndex="1" />
                <TextField fx:id="campoModelo" styleClass="campo-texto" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label styleClass="rotulo-campo" text="Marca" GridPane.rowIndex="2" />
                <TextField fx:id="campoMarca" styleClass="campo-texto" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label styleClass="rotulo-campo" text="Categoria" GridPane.rowIndex="3" />
                <TextField fx:id="campoCategoria" styleClass="campo-texto" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label styleClass="rotulo-campo" text="Valor da diária" GridPane.rowIndex="4" />
                <TextField fx:id="campoValor" styleClass="campo-texto" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                <CheckBox fx:id="ckbDisponivel" mnemonicParsing="false" styleClass="rotulo-campo" text="Disponível" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>

            <HBox styleClass="linha-botoes">
                <Button fx:id="btnSalvar" mnemonicParsing="false" onAction="#salvar" styleClass="btn-primario" text="Salvar" />
                <Button fx:id="btnLimpar" mnemonicParsing="false" onAction="#limpar" styleClass="btn-secundario" text="Limpar" />
                <Button fx:id="btnVoltar" mnemonicParsing="false" onAction="#voltar" styleClass="btn-secundario" text="Voltar" />
            </HBox>
        </VBox>

        <VBox styleClass="bloco-tabela">
            <TableView fx:id="tabelaVeiculo" prefHeight="260" styleClass="tabela-padrao">
                <columns>
                    <TableColumn fx:id="colunaPlaca" prefWidth="110" text="Placa" />
                    <TableColumn fx:id="colunaModelo" prefWidth="140" text="Modelo" />
                    <TableColumn fx:id="colunaMarca" prefWidth="130" text="Marca" />
                    <TableColumn fx:id="colunaCategoria" prefWidth="130" text="Categoria" />
                    <TableColumn fx:id="colunaValor" prefWidth="180" text="Valor da Diária" />
                </columns>
            </TableView>
        </VBox>
    </VBox>
</VBox>
